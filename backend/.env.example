# Library settings (copy to backend/.env and fill in)
# LLM for summarization — any OpenAI-compatible endpoint works
LIBRARY_LLM_BASE_URL=https://openrouter.ai/api/v1
LIBRARY_LLM_API_KEY=
LIBRARY_LLM_MODEL=z-ai/glm-5.3-flash
# Optional overrides
# LIBRARY_DATABASE_URL=sqlite:///./data/library.db
# LIBRARY_STORAGE_DIR=./data/files
# LIBRARY_CHUNK_CHARS=12000
