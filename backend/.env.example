# Copy to backend/.env (local dev) or repo-root .env (docker compose) and fill in

# Database — docker compose provides Postgres automatically; for bare local dev use:
# LIBRARY_DATABASE_URL=postgresql+psycopg://library:library@localhost:5432/library

# LLM for summarization — any OpenAI-compatible endpoint
LIBRARY_LLM_BASE_URL=https://openrouter.ai/api/v1
LIBRARY_LLM_API_KEY=
LIBRARY_LLM_MODEL=z-ai/glm-5.3-flash

# Session signing secret (generate: python3 -c "import secrets;print(secrets.token_hex(32))")
LIBRARY_JWT_SECRET=

# Google OAuth — optional; leave empty to disable Google login button
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:8080/api/auth/google/callback
LIBRARY_GOOGLE_CLIENT_ID=
LIBRARY_GOOGLE_CLIENT_SECRET=
# Base URL users hit in the browser, no trailing slash, e.g. http://localhost:8080
LIBRARY_OAUTH_REDIRECT_BASE=http://localhost:8080
