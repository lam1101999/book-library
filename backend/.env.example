# Library settings (copy to backend/.env and fill in)
# Database — Postgres connection string (docker compose provides one automatically)
# Local dev default: sqlite:///./data/library.db
LIBRARY_DATABASE_URL=postgresql+psycopg://library:library@localhost:5432/library

# LLM for summarization — any OpenAI-compatible endpoint
LIBRARY_LLM_BASE_URL=https://openrouter.ai/api/v1
LIBRARY_LLM_API_KEY=
LIBRARY_LLM_MODEL=z-ai/glm-5.3-flash

# Session signing secret (generate: python -c "import secrets; print(secrets.token_hex(32))")
LIBRARY_JWT_SECRET=

# Google OAuth (optional): create OAuth client at console.cloud.google.com
# Authorized redirect URI: <your-app-url>/auth/google/callback
LIBRARY_GOOGLE_CLIENT_ID=
LIBRARY_GOOGLE_CLIENT_SECRET=
LIBRARY_OAUTH_REDIRECT_BASE=http://localhost:5173
